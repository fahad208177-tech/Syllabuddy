# Copy to .env (gitignored). Pick ONE brain for the simulated Alexa+.
# With nothing set, the app runs in "offline" mode: no model, no keys, still fully working via MCP.

# --- Groq or any OpenAI-compatible API (used for the demo) ---
# SYLLABUDDY_BRAIN=openai
# SYLLABUDDY_LLM_BASE_URL=https://api.groq.com/openai/v1
# SYLLABUDDY_LLM_API_KEY=
# SYLLABUDDY_LLM_MODEL=openai/gpt-oss-120b
# SYLLABUDDY_LLM_REASONING=low

# --- Amazon Bedrock (optional; needs an AWS account with Bedrock access) ---
# SYLLABUDDY_BRAIN=bedrock
# AWS_PROFILE=default            # or AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0

# --- Ollama, fully local ---
# SYLLABUDDY_BRAIN=openai
# SYLLABUDDY_LLM_BASE_URL=http://localhost:11434/v1
# SYLLABUDDY_LLM_MODEL=qwen3:8b

# --- Deployment (python -m deploy.serve or the Dockerfile) ---
# SYLLABUDDY_PUBLIC_URL=https://your.host     # turns on OAuth account linking (automatic on Hugging Face Spaces)
# SYLLABUDDY_RATE_LIMIT=8                      # questions per visitor per minute on a public demo
# HF_TOKEN=                                    # only for deploy/publish_space.py; never committed
